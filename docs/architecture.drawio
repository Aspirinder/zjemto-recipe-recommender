  <diagram id="Vyl6NfcUQ9dQfJF89DG_" name="API-data flow">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    CLIENT[\&quot;ZjemTo App&lt;br/&gt;React + TypeScript\&quot;]\n\n    subgraph BACKEND[\&quot;ZjemTo FastAPI — Azure App Service\&quot;]\n        direction TB\n\n        AUTH[\&quot;Authentication&lt;br/&gt;POST /api/users/signup&lt;br/&gt;POST /api/users/signin&lt;br/&gt;Argon2 password hashing\&quot;]\n\n        ALLERGIES[\&quot;Allergy Management&lt;br/&gt;GET /api/users/{user_id}/allergies&lt;br/&gt;PUT /api/users/{user_id}/allergies\&quot;]\n\n        FEED[\&quot;Recipe Feed&lt;br/&gt;GET /api/recipes/feed/{user_id}\&quot;]\n\n        CAL[\&quot;Calibration Mode&lt;br/&gt;Not calibrated OR empty profile&lt;br/&gt;Up to 20 - swipes_done recipes\&quot;]\n\n        PERSONAL[\&quot;Personalized Mode&lt;br/&gt;ML recommendations&lt;br/&gt;Top 10 recipe IDs\&quot;]\n\n        SWIPE[\&quot;Swipe Handler&lt;br/&gt;POST /api/swipe&lt;br/&gt;Like / Dislike\&quot;]\n\n        PROFILE[\&quot;Profile Update&lt;br/&gt;Weight decay: 0.9&lt;br/&gt;Positive / Negative weights&lt;br/&gt;Update profile_vector\&quot;]\n\n        FILTER[\&quot;Allergy Filtering&lt;br/&gt;Build excluded_recipe_ids\&quot;]\n    end\n\n    subgraph DATABASE[\&quot;Azure PostgreSQL — Connection Pool 1..10\&quot;]\n        direction TB\n\n        USERS[(\&quot;users&lt;br/&gt;user_id, user_email&lt;br/&gt;hash_password, allergies&lt;br/&gt;profile_vector, is_calibrated\&quot;)]\n\n        SWIPES_DB[(\&quot;user_swipes&lt;br/&gt;user_id, recipe_id, action\&quot;)]\n\n        RECIPES[(\&quot;food_recipes&lt;br/&gt;recipe details, tfidf_vector\&quot;)]\n\n        ALLERGENS[(\&quot;recipe_allergens&lt;br/&gt;recipe_id, allergen_tag\&quot;)]\n    end\n\n    subgraph CACHE[\&quot;Redis Cloud\&quot;]\n        REDIS[(\&quot;Allergy Blacklist Cache&lt;br/&gt;TTL: 3600 seconds\&quot;)]\n    end\n\n    subgraph ML_SERVICE[\&quot;ZjemTo ML Service — Azure App Service\&quot;]\n        ML[\&quot;ML Engine&lt;br/&gt;POST /api/recommend&lt;br/&gt;Cosine Similarity\&quot;]\n    end\n\n    CLIENT --&gt;|\&quot;Sign up / Sign in\&quot;| AUTH\n    AUTH &lt;--&gt;|\&quot;Create / find user\&quot;| USERS\n    AUTH --&gt;|\&quot;user_id\&quot;| CLIENT\n\n    CLIENT --&gt;|\&quot;Get / update allergies\&quot;| ALLERGIES\n    ALLERGIES &lt;--&gt;|\&quot;Read / update allergies\&quot;| USERS\n    ALLERGIES --&gt;|\&quot;Allergies / status\&quot;| CLIENT\n\n    CLIENT --&gt;|\&quot;1. Request recipe feed\&quot;| FEED\n    FEED --&gt;|\&quot;Read user profile and allergies\&quot;| USERS\n\n    FEED --&gt;|\&quot;Not calibrated\&quot;| CAL\n    FEED --&gt;|\&quot;Calibrated and profile exists\&quot;| PERSONAL\n\n    CAL --&gt;|\&quot;Read existing swipes\&quot;| SWIPES_DB\n    CAL --&gt; FILTER\n    CAL --&gt;|\&quot;Fetch calibration recipes\&quot;| RECIPES\n\n    PERSONAL --&gt;|\&quot;Read previous swipes\&quot;| SWIPES_DB\n    PERSONAL --&gt; FILTER\n\n    FILTER &lt;--&gt;|\&quot;Check / store blacklist\&quot;| REDIS\n    FILTER -.-&gt;|\&quot;Cache miss / Redis unavailable\&quot;| ALLERGENS\n\n    PERSONAL --&gt;|\&quot;user_vector, swiped_ids,&lt;br/&gt;excluded_recipe_ids, limit=10\&quot;| ML\n\n    ML --&gt;|\&quot;recommended_recipe_ids\&quot;| PERSONAL\n\n    PERSONAL --&gt;|\&quot;Fetch recipe details\&quot;| RECIPES\n\n    CAL --&gt;|\&quot;Calibration feed + progress\&quot;| CLIENT\n    PERSONAL --&gt;|\&quot;Personalized recipe feed\&quot;| CLIENT\n\n    CLIENT --&gt;|\&quot;2. Like / Dislike\&quot;| SWIPE\n    SWIPE --&gt;|\&quot;Insert unique swipe\&quot;| SWIPES_DB\n\n    SWIPE --&gt;|\&quot;New swipe\&quot;| PROFILE\n    PROFILE --&gt;|\&quot;Read recipe TF-IDF vector\&quot;| RECIPES\n    PROFILE &lt;--&gt;|\&quot;Read / update profile_vector\&quot;| USERS\n\n    SWIPE --&gt;|\&quot;After 20 swipes: is_calibrated = true\&quot;| USERS\n    SWIPE --&gt;|\&quot;success / already_recorded\&quot;| CLIENT\n\n    classDef client fill:#1e293b,stroke:#94a3b8,color:#ffffff\n    classDef api fill:#252033,stroke:#a855f7,color:#ffffff\n    classDef database fill:#102b26,stroke:#10b981,color:#ffffff\n    classDef cache fill:#29220f,stroke:#f59e0b,color:#ffffff\n    classDef ml fill:#172554,stroke:#60a5fa,color:#ffffff\n\n    class CLIENT client\n    class AUTH,ALLERGIES,FEED,CAL,PERSONAL,SWIPE,PROFILE,FILTER api\n    class USERS,SWIPES_DB,RECIPES,ALLERGENS database\n    class REDIS cache\n    class ML ml&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="rwfPYP-V_bQvsFV7hECI-1">
